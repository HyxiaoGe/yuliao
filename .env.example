# 复制为 .env.local 后填写，.env.local 已被 gitignore。
# EXPO_PUBLIC_ 前缀的变量都会打进客户端包，所以这里只放"可以公开给这台设备"的东西。

# 推荐：走自己的后端（见 server/），Token 是后端 APP_TOKENS 里的一个
EXPO_PUBLIC_CHAT_BASE_URL=http://192.168.1.11:8787/v1
EXPO_PUBLIC_CHAT_TOKEN=

# 可选：指定模型，需在后端 ALLOWED_MODELS 白名单内；留空由后端决定
EXPO_PUBLIC_CHAT_MODEL=

# 深度思考默认关闭（首字更快）；填 1 开启
EXPO_PUBLIC_CHAT_THINKING=
