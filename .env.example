# 火山方舟（豆包）配置。复制为 .env.local 后填入真实值，.env.local 已被 gitignore。
# 注意：EXPO_PUBLIC_ 前缀的变量会被打进客户端包，仅限原型阶段直连使用；
# 正式版本应由轻量后端持有 Key，APP 只改 EXPO_PUBLIC_ARK_BASE_URL 指向后端即可。
EXPO_PUBLIC_ARK_API_KEY=
EXPO_PUBLIC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID 或推理接入点 ID（ep-xxx），以方舟控制台"开通管理"里的为准
EXPO_PUBLIC_ARK_MODEL=doubao-seed-2-0-mini-260428
# 深度思考默认关闭（首字更快）；填 1 开启
EXPO_PUBLIC_ARK_THINKING=
