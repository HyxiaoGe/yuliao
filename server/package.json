{
  "name": "yuliao-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "语聊轻量后端：持有方舟 Key，转发 Chat Completions 流式请求",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test \"src/**/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3"
  }
}
