# 监听端口
PORT=8787

# Postgres（dev 服务器：postgresql://admin:<密码>@postgres:5432/yuliao?client_encoding=utf8）
DATABASE_URL=
# 发给模型的最近消息条数、系统提示词
HISTORY_LIMIT=20
SYSTEM_PROMPT=你是一个友好、简洁的中文聊天助手。涉及最新动态、实时信息或你不确定的事实时，先联网搜索再回答。
# 联网搜索（豆包搜索 Custom 版）：需先在方舟控制台「开通管理 > 应用组件库 > 豆包搜索」开通，
# 按搜索次数计费（0.02 元/次，有免费额度）。模型自行判断是否搜索。设为 0 关闭
WEB_SEARCH=1

# 火山方舟（豆包）。Key 只存在于服务器，App 不再持有
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认模型；客户端传的 model 只有在 ALLOWED_MODELS 里才生效，否则用这个
ARK_MODEL=doubao-seed-2-0-mini-260428
# 可选，逗号分隔。留空表示客户端不能自选模型
ALLOWED_MODELS=

# App 鉴权：客户端在 Authorization: Bearer <token> 里带上其中一个。逗号分隔可配多个，便于轮换
APP_TOKENS=

# 每个 token 每分钟允许的请求数
RATE_LIMIT_PER_MIN=30
# 单次请求最多带多少条消息 / 多少字符，防止被刷额度
MAX_MESSAGES=40
MAX_CHARS=20000

# 豆包语音合成 2.0（可选，不填则 App 的朗读功能不可用）
# Key 在豆包语音控制台「API Key 管理」创建，与方舟 Key 不通用；需先开通「语音合成 2.0」
TTS_API_KEY=
# TTS_RESOURCE_ID=seed-tts-2.0
# TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 单次合成最大字符数
# TTS_MAX_CHARS=600
# 音量：-50..100，100 为 2 倍；豆包默认输出偏小，默认 70
# TTS_LOUDNESS=70
