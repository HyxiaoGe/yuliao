# 监听端口
PORT=8787

# 火山方舟（豆包）。Key 只存在于服务器，App 不再持有
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认模型；客户端传的 model 只有在 ALLOWED_MODELS 里才生效，否则用这个
ARK_MODEL=doubao-seed-2-0-mini-260428
# 可选，逗号分隔。留空表示客户端不能自选模型
ALLOWED_MODELS=

# App 鉴权：客户端在 Authorization: Bearer <token> 里带上其中一个。逗号分隔可配多个，便于轮换
APP_TOKENS=

# 每个 token 每分钟允许的请求数
RATE_LIMIT_PER_MIN=30
# 单次请求最多带多少条消息 / 多少字符，防止被刷额度
MAX_MESSAGES=40
MAX_CHARS=20000
